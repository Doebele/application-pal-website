---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'application-pal — Local-first job application tracker with AI coaching',
  description = 'Track job applications on a Kanban board, table, and timeline. AI cover-letter coaching, interview prep, and RAV/ORP proof-of-search export — all self-hosted on your machine. Free and open source.',
  ogImage = '/application-pal-website/og-image.png',
} = Astro.props;

const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OG / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/application-pal-website/favicon.svg" />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <!-- analytics -->

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        /* medvesek.com design system — ink / paper / accent */
        --bg: #0b0b0c;
        --bg2: #1a1a1d;
        --bg3: #111113;
        --border: #f5f3ee24;
        --text: #f5f3ee;
        --text-muted: #8a8780;
        --accent: #ff5b2e;
        --accent-ink: #ff5b2e;
        --nav-bg: rgba(11, 11, 12, 0.85);
        --green: #8a8780;
        --purple: #ff5b2e;
        --font: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-serif: 'Instrument Serif', ui-serif, Georgia, serif;
        --font-mono: 'Fira Code', ui-monospace, 'SFMono-Regular', Menlo, monospace;
        --radius: 6px;
        --max-width: 1100px;
        color-scheme: dark;
      }

      html[data-theme='light'] {
        --bg: #f5f3ee;
        --bg2: #e9e6dd;
        --bg3: #faf9f5;
        --border: #0b0b0c1f;
        --text: #0b0b0c;
        --text-muted: #75726b;
        --accent: #ff5b2e;
        --accent-ink: #b93107;
        --nav-bg: rgba(245, 243, 238, 0.88);
        color-scheme: light;
      }

      html { scroll-behavior: smooth; }

      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        font-size: 16px;
        font-weight: 400;
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
      }

      ::selection { background: var(--accent); color: var(--bg); }

      a { color: var(--accent-ink); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* kill the user-agent default (`code { font-family: monospace }`)
         that overrides Fira Code on inline code elements */
      code, kbd, samp, pre, .mono { font-family: var(--font-mono); }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      @media (min-width: 640px) {
        .container { padding: 0 2rem; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
