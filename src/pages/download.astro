---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const GITHUB_URL = 'https://github.com/Doebele/application-pal';

// Current desktop release. Update VERSION (and the sizes) here when a new version ships.
const VERSION = '0.4.0';
const RELEASE_TAG = `desktop-v${VERSION}`;
const RELEASE_BASE = `https://github.com/Doebele/application-pal/releases/download/${RELEASE_TAG}`;
const RELEASES_URL = 'https://github.com/Doebele/application-pal/releases';

const platforms = [
  {
    id: 'mac-arm',
    os: 'mac',
    arch: 'arm',
    icon: 'apple-mac',
    title: 'Mac · Apple Silicon',
    file: `Apply-Pal_${VERSION}_aarch64.dmg`,
    hint: 'macOS on M-series chips (M1 and later) · signed & notarized',
  },
  {
    id: 'mac-intel',
    os: 'mac',
    arch: 'intel',
    icon: 'apple-mac',
    title: 'Mac · Intel',
    file: `Apply-Pal_${VERSION}_x64.dmg`,
    size: '63 MB',
    hint: 'legacy macOS on Intel Macs · signed & notarized',
  },
  {
    id: 'windows',
    os: 'windows',
    arch: '',
    icon: 'app-window',
    title: 'Windows',
    file: `Apply-Pal_${VERSION}_x64-setup.exe`,
    hint: 'Windows 10 / 11 · 64-bit',
  },
];
---

<Layout
  title="Download Apply-Pal — Desktop app for Mac and Windows"
  description="Download the Apply-Pal desktop app for Mac (Apple Silicon and Intel) and Windows. No Docker needed — your data stays on your computer."
>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/application-pal-website/" class="nav-logo">
        <Icon name="attachment" size={22} class="logo-icon" />
        <span>application-pal</span>
      </a>
      <nav class="nav-links">
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="github-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
        <ThemeToggle />
      </nav>
    </div>
  </header>

  <main class="install-page">
    <div class="container">
      <div class="page-header">
        <h1>Download Apply-Pal</h1>
        <p class="page-sub">
          The Apply-Pal desktop app for Mac and Windows — a single download, no Docker needed.
          Your data stays on your computer.
        </p>
      </div>

      <!-- PLATFORM CARDS -->
      <section class="step-section">
        <h2>Choose your platform</h2>
        <div class="platform-grid">
          {platforms.map(p => (
            <div class="platform-card" data-os={p.os} data-arch={p.arch || undefined}>
              <div class="platform-head">
                <span class="platform-icon"><Icon name={p.icon} size={26} /></span>
                <div>
                  <div class="platform-title">{p.title}</div>
                  <div class="platform-hint">{p.hint}</div>
                </div>
                <span class="reco">Recommended for your system</span>
              </div>
              <div class="platform-file"><code>{p.file}</code>{p.size && <span class="platform-size"> · {p.size}</span>}</div>
              <a class="btn-primary" href={`${RELEASE_BASE}/${p.file}`} download>
                <Icon name="download-circle" size={16} />
                Download
              </a>
            </div>
          ))}
        </div>
        <p>
          Looking for another or an earlier version? See
          <a href={RELEASES_URL} target="_blank" rel="noopener">all releases</a> on GitHub, or link
          straight to the
          <a href="https://github.com/Doebele/application-pal/releases/latest" target="_blank" rel="noopener">latest release</a> —
          this page points at <code>{RELEASE_TAG}</code>.
        </p>
        <p class="note">
          New in desktop 0.4.0: a mode built for school leavers — a simpler app, letters for
          taster apprenticeships and apprenticeships, and gentle career-choice ideas. Already
          installed? The app updates itself: accept the dialog on launch, or use
          <strong>Settings → Check for updates</strong>.
        </p>
      </section>

      <!-- FIRST LAUNCH -->
      <section class="step-section">
        <h2>First launch</h2>
        <p>
          The operating system asks for a one-time confirmation the first time you open the app.
        </p>
        <div class="launch-grid">
          <div class="launch-card">
            <h3><Icon name="apple-mac" size={18} /> Mac</h3>
            <p>
              Open the <code>.dmg</code> and drag Apply-Pal into <strong>Applications</strong>.
              The app is signed and notarized by Apple, so macOS only asks once whether you
              want to open an app downloaded from the internet — click <strong>Open</strong>.
            </p>
          </div>
          <div class="launch-card">
            <h3><Icon name="app-window" size={18} /> Windows</h3>
            <p>
              The Windows installer is not code-signed yet, so SmartScreen warns about an
              <strong>unknown publisher</strong>. Click <strong>“More info”</strong>, then
              <strong>“Run anyway”</strong> — the app runs fine.
            </p>
          </div>
        </div>
      </section>

      <!-- REQUIREMENTS -->
      <section class="step-section">
        <h2>Requirements</h2>
        <ul class="req-list">
          <li><strong>macOS</strong> — Apple Silicon or Intel</li>
          <li><strong>Windows 10 / 11</strong> — 64-bit</li>
          <li><strong>No Docker needed</strong> — the desktop app is a standalone install</li>
          <li><strong>Data stays local</strong> — stored on your computer; it only goes to Google or an AI provider if you connect one</li>
          <li><strong>Multiple profiles</strong> — several people can use the app on one computer</li>
          <li><strong>Setup wizard</strong> — Google and your AI provider are configured on first launch</li>
          <li><strong>Automatic updates</strong> — the app updates itself: accept the dialog on launch, or use Settings → Check for updates</li>
        </ul>
      </section>

      <!-- DOCKER CROSS-LINK -->
      <section class="step-section">
        <h2>Prefer Docker?</h2>
        <p>
          The web version keeps the name <strong>application-pal</strong> and runs via
          <code>docker compose</code> — same features, your machine, your ports:
        </p>
        <p>
          <a href="/application-pal-website/install">→ Docker install guide</a>
        </p>
      </section>
    </div>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <Icon name="attachment" size={20} class="logo-icon" />
        <span>application-pal</span>
      </div>
      <div class="footer-links">
        <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
        <a href="/application-pal-website/">Home</a>
        <a href="/application-pal-website/install">Docker install</a>
        <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT License · © 2026 Claus Medvesek</a>
      </div>
    </div>
  </footer>
</Layout>

<!-- OS detection (progressive enhancement): highlight the matching card.
     Without JS, all cards look the same and every link works. -->
<script is:inline>
  (function () {
    try {
      var ua = navigator.userAgent || '';
      var html = document.documentElement;
      if (/Windows/i.test(ua)) {
        html.setAttribute('data-os', 'windows');
      } else if (/Mac/i.test(ua)) {
        html.setAttribute('data-os', 'mac');
        // Browsers still report "MacIntel" on Apple Silicon and there is no
        // reliable sync signal for Intel — default to the Apple Silicon card
        // (most Macs since 2020); the Intel card stays one glance away.
        html.setAttribute('data-arch', 'arm');
      }
    } catch (e) { /* ignore */ }
  })();
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 60px; gap: 1rem;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-serif); font-size: 1.25rem;
    color: var(--text); text-decoration: none;
  }
  .logo-icon { color: var(--accent-ink); }
  .nav-links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.9rem; }
  .nav-links a { color: var(--text-muted); }
  .nav-links a:hover { color: var(--text); text-decoration: none; }
  .github-link { display: flex; align-items: center; gap: 0.4rem; }

  .install-page { padding: 3rem 0 4rem; }
  .page-header { margin-bottom: 3rem; }
  .page-header h1 {
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.75rem;
  }
  .page-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 640px; }

  .step-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .step-section:last-of-type { border-bottom: none; }
  .step-section h2 {
    font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;
  }
  .step-section p { color: var(--text-muted); margin-bottom: 0.75rem; line-height: 1.7; }
  .step-section p strong { color: var(--text); }
  .step-section a { color: var(--accent-ink); }

  /* ── Platform cards ─────────────────────────────────────── */
  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
    margin: 1rem 0 1.25rem;
  }
  .platform-card {
    display: flex; flex-direction: column; gap: 1rem;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.4rem;
    transition: border-color 0.15s;
  }
  .platform-card:hover { border-color: var(--text-muted); }
  .platform-head { display: flex; flex-direction: column; gap: 0.65rem; }
  .platform-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--bg2);
    color: var(--accent-ink);
  }
  .platform-title { font-size: 1rem; font-weight: 600; color: var(--text); }
  .platform-hint { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem; }
  .platform-file { font-size: 0.85rem; color: var(--text-muted); }
  .platform-size { font-family: var(--font-mono); font-size: 0.78rem; }
  .platform-file code { font-size: 0.78rem; word-break: break-all; }

  .reco {
    display: none; align-items: center; gap: 0.35rem;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .reco::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 6px var(--accent);
  }

  /* OS highlight — set by the inline script above, harmless without it */
  html[data-os='windows'] .platform-card[data-os='windows'],
  html[data-os='mac'][data-arch='arm'] .platform-card[data-os='mac'][data-arch='arm'],
  html[data-os='mac'][data-arch='intel'] .platform-card[data-os='mac'][data-arch='intel'] {
    border-color: var(--accent);
  }
  html[data-os='windows'] .platform-card[data-os='windows'] .reco,
  html[data-os='mac'][data-arch='arm'] .platform-card[data-os='mac'][data-arch='arm'] .reco,
  html[data-os='mac'][data-arch='intel'] .platform-card[data-os='mac'][data-arch='intel'] .reco {
    display: inline-flex;
  }

  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    background: var(--accent); color: #0b0b0c;
    padding: 0.7rem 1.5rem; border-radius: var(--radius);
    font-weight: 600; font-size: 0.95rem; text-decoration: none;
    margin-top: auto;
    transition: background 0.15s;
  }
  /* Astro's scoped .step-section a rule (higher specificity) would paint the
     label accent-on-accent — pin the ink text explicitly */
  .platform-card .btn-primary { color: #0b0b0c; }
  .btn-primary:hover { background: #ff7049; text-decoration: none; }

  /* ── First launch ───────────────────────────────────────── */
  .launch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .launch-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
  }
  .launch-card h3 {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text);
  }
  .launch-card p { font-size: 0.92rem; }
  .launch-card em { font-style: normal; }

  .note {
    background: var(--bg3); border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 0.75rem 1rem;
    font-size: 0.9rem; color: var(--text-muted);
  }

  .code-block {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 0.85rem 1rem;
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500;
    color: var(--accent-ink); margin: 0.5rem 0 0;
    white-space: pre-wrap; word-break: break-all;
  }
  code {
    font-family: var(--font-mono); font-weight: 500;
    background: var(--bg2); border: 1px solid var(--border);
    padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.875rem;
    color: var(--accent-ink);
  }

  .req-list { padding-left: 1.25rem; color: var(--text-muted); }
  .req-list li { margin-bottom: 0.5rem; line-height: 1.65; }
  .req-list strong { color: var(--text); }

  .footer { border-top: 1px solid var(--border); padding: 2rem 0; background: var(--bg2); }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-brand {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-serif); font-size: 1.2rem; font-weight: 400;
  }
  .footer-links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.9rem; flex-wrap: wrap; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); text-decoration: none; }
</style>
