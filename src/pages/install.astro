---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const GITHUB_URL = 'https://github.com/Doebele/application-pal';
---

<Layout
  title="Install application-pal — Docker Quickstart"
  description="Step-by-step guide to install application-pal with Docker. Get your local job tracker running in under five minutes."
>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/application-pal-website/" class="nav-logo">
        <Icon name="attachment" size={22} class="logo-icon" />
        <span>application-pal</span>
      </a>
      <nav class="nav-links">
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="github-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
        <ThemeToggle />
      </nav>
    </div>
  </header>

  <main class="install-page">
    <div class="container">
      <div class="page-header">
        <h1>Quickstart Install</h1>
        <p class="page-sub">
          application-pal runs entirely in Docker. You need nothing else installed except Docker Desktop.
        </p>
      </div>

      <!-- PREREQUISITES -->
      <section class="step-section">
        <h2><span class="step-badge">Pre</span> Prerequisites</h2>
        <ul class="req-list">
          <li>
            <strong>Docker Desktop</strong> — <a href="https://www.docker.com/products/docker-desktop/" target="_blank" rel="noopener">download for Mac, Windows, or Linux</a>
          </li>
          <li><code>curl</code> (pre-installed on Mac and Linux) to download two files</li>
          <li>2 GB free disk space for images and database</li>
        </ul>
      </section>

      <!-- STEP 1 -->
      <section class="step-section">
        <h2><span class="step-badge">1</span> Download the compose file and .env template</h2>
        <p>No clone required — the release compose file pulls pre-built images. Run in a dedicated folder:</p>
        <pre class="code-block"><code>curl -O https://raw.githubusercontent.com/Doebele/application-pal/main/docker-compose.release.yml
curl -O https://raw.githubusercontent.com/Doebele/application-pal/main/.env.example
cp .env.example .env</code></pre>
        <p class="note">
          Open <code>.env</code> and change <code>POSTGRES_PASSWORD</code> to a secure value
          of your choice — this is the only mandatory edit.
        </p>
      </section>

      <!-- STEP 2 -->
      <section class="step-section">
        <h2><span class="step-badge">2</span> Start the services</h2>
        <p>Run Docker Compose in detached mode. This pulls the images and starts the database, backend, and frontend:</p>
        <pre class="code-block"><code>docker compose -f docker-compose.release.yml up -d</code></pre>
        <p class="note">
          The first start takes about a minute while all services initialise.
          Subsequent starts are fast.
        </p>
        <p>You should see output similar to:</p>
        <pre class="code-block output"><code>[+] Running 3/3
 ✔ Container application-pal-db-1        Healthy
 ✔ Container application-pal-backend-1   Healthy
 ✔ Container application-pal-frontend-1  Started</code></pre>
      </section>

      <!-- STEP 3 -->
      <section class="step-section">
        <h2><span class="step-badge">3</span> Create your account</h2>
        <p>Navigate to the app in your browser:</p>
        <pre class="code-block"><code>http://localhost:8070</code></pre>
        <p>
          The setup form guides you through creating your first account (e-mail + password,
          minimum 8 characters). Additional users join later via invite links.
        </p>
      </section>

      <!-- STEP 4 -->
      <section class="step-section">
        <h2><span class="step-badge">4</span> Add your first application</h2>
        <p>
          Once logged in, click <strong>+ Import job</strong> and paste a job-ad URL, or add the
          company and role manually. The board shows it in the <em>Inbox</em> column — move it
          through <em>CV → Cover Letter → Sent → Interview</em> as your process progresses.
        </p>
      </section>

      <!-- AI COACHING (OPTIONAL) -->
      <section class="step-section">
        <h2><span class="step-badge">5</span> (Optional) Enable AI features</h2>
        <p>
          Six providers are supported — configured under <strong>Settings → AI Integration</strong>
          in the app, no config files needed. Without any provider the app runs as a pure
          management tool.
        </p>
        <ul class="req-list">
          <li>
            <strong>LM Studio / Ollama (local, free)</strong> — install
            <a href="https://lmstudio.ai" target="_blank" rel="noopener">LM Studio</a> or
            <a href="https://ollama.com" target="_blank" rel="noopener">Ollama</a> and load a model
            (Qwen3 8B or better, e.g. <code>ollama pull qwen3:8b</code>).
          </li>
          <li>
            <strong>Cloud providers</strong> — Anthropic, OpenAI, Google Gemini (free tier),
            or OpenRouter with your own API key.
          </li>
        </ul>
        <p>Detailed configuration options are in the project <a href={`${GITHUB_URL}#readme`} target="_blank" rel="noopener">README</a> and <a href={`${GITHUB_URL}/blob/main/docs/ai-setup.md`} target="_blank" rel="noopener">docs/ai-setup.md</a>.</p>
      </section>

      <!-- GOOGLE DRIVE (OPTIONAL) -->
      <section class="step-section">
        <h2><span class="step-badge">6</span> (Optional) Connect Google Drive &amp; Sign-In</h2>
        <p>
          With Google connected, application-pal automatically creates a Drive folder per job the
          moment you add it, copies your CV and cover-letter templates with formatting intact, and
          exports AI-generated content as formatted Google Docs. Google Sign-In also becomes
          available as a login method next to e-mail and passkeys.
        </p>
        <p>
          Setup runs entirely through a Google Cloud OAuth client — no server-side Google account
          needed. The step-by-step guide (Cloud Console, consent screen, OAuth client, five
          <code>.env</code> keys, container restart) takes about ten minutes:
        </p>
        <p class="note">
          → Full guide: <a href={`${GITHUB_URL}/blob/main/docs/google-setup.md`} target="_blank" rel="noopener">docs/google-setup.md</a>
        </p>
      </section>

      <!-- OPTIONAL FEATURES OVERVIEW -->
      <section class="step-section">
        <h2>Optional features</h2>
        <p>
          Everything below is optional — without any of it, the app runs as a pure management tool.
          The guides live with the application repository:
        </p>
        <ul class="req-list">
          <li>
            <strong><a href={`${GITHUB_URL}/blob/main/docs/google-setup.md`} target="_blank" rel="noopener">Google Drive &amp; Sign-In</a></strong> —
            per-application folders, template copies, Google Doc export (see step 6 above)
          </li>
          <li>
            <strong><a href={`${GITHUB_URL}/blob/main/docs/ai-setup.md`} target="_blank" rel="noopener">AI integration</a></strong> —
            LM Studio / Ollama locally, or Anthropic, OpenAI, Google Gemini, and OpenRouter via API key
          </li>
          <li>
            <strong><a href={`${GITHUB_URL}/blob/main/docs/cover-letter.md`} target="_blank" rel="noopener">Cover Letter Coach</a></strong> —
            personal guidance the AI applies to every generated letter
          </li>
          <li>
            <strong><a href={`${GITHUB_URL}/blob/main/docs/rav-export.md`} target="_blank" rel="noopener">RAV / ORP export</a></strong> —
            proof-of-job-search reports as Google Sheets or CSV
          </li>
          <li>
            <strong><a href={`${GITHUB_URL}/blob/main/docs/backup.md`} target="_blank" rel="noopener">Data backup &amp; migration</a></strong> —
            securing and moving your PostgreSQL data
          </li>
        </ul>
        <p>
          The overview in the application repository lives at
          <a href={`${GITHUB_URL}#optional-features`} target="_blank" rel="noopener">application-pal → Optional features</a>.
        </p>
      </section>

      <!-- STOPPING -->
      <section class="step-section">
        <h2>Stopping &amp; updating</h2>
        <pre class="code-block"><code># Stop containers (data is preserved)
docker compose -f docker-compose.release.yml down

# Update to the latest release
docker compose -f docker-compose.release.yml pull
docker compose -f docker-compose.release.yml up -d</code></pre>
      </section>

      <!-- TROUBLESHOOTING -->
      <section class="step-section">
        <h2>Troubleshooting</h2>
        <details class="faq">
          <summary>Port 8070 is already in use</summary>
          <p>
            Edit <code>docker-compose.release.yml</code> and change <code>8070:80</code> to
            <code>8170:80</code> (or any free port), then open <code>http://localhost:8170</code>.
          </p>
        </details>
        <details class="faq">
          <summary>Docker says "no configuration file provided"</summary>
          <p>
            Make sure you're in the folder that contains
            <code>docker-compose.release.yml</code>. Run <code>ls</code> to confirm.
          </p>
        </details>
        <details class="faq">
          <summary>App loads but shows a database error</summary>
          <p>
            Wait a few seconds and refresh — the database container may still be initialising.
            If it persists, run <code>docker compose -f docker-compose.release.yml logs db</code> for details.
          </p>
        </details>
      </section>

      <div class="cta-block">
        <p>Questions? Open an issue on GitHub — we respond quickly.</p>
        <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener" class="btn-primary">Open an issue</a>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <Icon name="attachment" size={20} class="logo-icon" />
        <span>application-pal</span>
      </div>
      <div class="footer-links">
        <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
        <a href="/application-pal-website/">Home</a>
        <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT License · © 2026 Claus Medvesek</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 60px; gap: 1rem;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 0.5rem;
    font-weight: 700; font-size: 1rem; color: var(--text); text-decoration: none;
  }
  .logo-icon { color: var(--accent); }
  .nav-links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.9rem; }
  .nav-links a { color: var(--text-muted); }
  .nav-links a:hover { color: var(--text); text-decoration: none; }
  .github-link { display: flex; align-items: center; gap: 0.4rem; }

  .install-page { padding: 3rem 0 4rem; }
  .page-header { margin-bottom: 3rem; }
  .page-header h1 {
    font-family: var(--font-serif); font-weight: 400; text-transform: lowercase;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.75rem;
  }
  .page-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 600px; }

  .step-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .step-section:last-of-type { border-bottom: none; }
  .step-section h2 {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;
  }
  .step-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 28px; height: 28px;
    background: transparent; color: var(--accent-ink);
    border: 1px solid var(--accent);
    border-radius: 6px; font-size: 0.8rem; font-weight: 500; font-family: var(--font-mono);
    padding: 0 6px;
  }
  .step-section p { color: var(--text-muted); margin-bottom: 0.75rem; line-height: 1.7; }

  .code-block {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 1rem 1.25rem;
    font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500;
    color: var(--accent-ink); overflow-x: auto; margin: 0.75rem 0;
    white-space: pre-wrap; word-break: break-all;
  }
  .code-block.output { color: var(--text-muted); }

  .note {
    background: var(--bg2); border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 0.75rem 1rem;
    font-size: 0.9rem; color: var(--text-muted) !important;
  }

  .req-list { padding-left: 1.25rem; color: var(--text-muted); }
  .req-list li { margin-bottom: 0.5rem; line-height: 1.65; }
  .req-list strong { color: var(--text); }
  code {
    font-family: var(--font-mono); font-weight: 500;
    background: var(--bg2); border: 1px solid var(--border);
    padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.875rem;
    color: var(--accent-ink);
  }

  .faq {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: var(--radius); margin-bottom: 0.75rem;
  }
  .faq summary {
    padding: 0.85rem 1rem; cursor: pointer; font-weight: 600; font-size: 0.95rem;
  }
  .faq summary:hover { color: var(--accent); }
  .faq p { padding: 0 1rem 0.85rem; color: var(--text-muted); font-size: 0.93rem; }

  .cta-block {
    text-align: center; padding: 2.5rem;
    background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);
    margin-top: 3rem;
  }
  .cta-block p { color: var(--text-muted); margin-bottom: 1rem; }
  .btn-primary {
    background: var(--accent); color: #0b0b0c;
    padding: 0.75rem 1.75rem; border-radius: var(--radius);
    font-weight: 600; font-size: 0.95rem; display: inline-block;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: #ff7049; text-decoration: none; }

  .footer { border-top: 1px solid var(--border); padding: 2rem 0; background: var(--bg2); }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .footer-links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.9rem; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); text-decoration: none; }
</style>
