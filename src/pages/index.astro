<!-- Scroll reveal -->
<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
</script>

<style>
  /* ── GLOBALS — medvesek.com design system (ink / paper / accent) ── */
  :root {
    --bg:      #0b0b0c;
    --bg2:     #1a1a1d;
    --bg3:     #111113;
    --border:  #f5f3ee24;
    --text:    #f5f3ee;
    --muted:   #8a8780;
    --accent:  #ff5b2e;
    --accent2: #ff5b2e;
    --green:   #8a8780;
    --line:    #f5f3ee24;
    --font:    'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --serif:   'Instrument Serif', ui-serif, Georgia, serif;
    --mono:    'Fira Code', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --r:       6px;
  }

  /* Scroll reveal base state */
  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: none;
  }
  /* Stagger siblings */
  [data-reveal]:nth-child(2) { transition-delay: 0.08s; }
  [data-reveal]:nth-child(3) { transition-delay: 0.16s; }
  [data-reveal]:nth-child(4) { transition-delay: 0.24s; }
  [data-reveal]:nth-child(5) { transition-delay: 0.32s; }

  /* ── NAV ──────────────────────────────────────────────────── */
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 62px; gap: 1rem;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1.35rem; letter-spacing: 0;
    color: var(--text); text-decoration: none;
  }
  .logo-mark { color: var(--accent-ink); }
  .nav-links { display: flex; align-items: center; gap: 1.5rem; font-size: 0.88rem; }
  .nav-links a { color: var(--muted); text-decoration: none; transition: color 0.15s; }
  .nav-links a:hover { color: var(--text); }
  .nav-gh { display: flex; align-items: center; gap: 0.4rem; }
  .btn-nav-cta {
    color: var(--accent-ink) !important;
    padding: 0.42rem 1.1rem; border-radius: 100px;
    border: 1px solid var(--accent);
    font-weight: 500; transition: background 0.15s, color 0.15s;
  }
  .btn-nav-cta:hover { background: var(--accent); color: #0b0b0c !important; }

  /* ── HERO ─────────────────────────────────────────────────── */
  .hero {
    position: relative; overflow: hidden;
    padding: 7rem 0 4.5rem;
    background: var(--bg);
  }
  .hero-glow {
    position: absolute; border-radius: 50%;
    filter: blur(90px); pointer-events: none;
  }
  .glow-1 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255,91,46,0.07) 0%, transparent 70%);
    top: -220px; left: -120px;
  }
  .glow-2 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(245,243,238,0.05) 0%, transparent 70%);
    top: -120px; right: -100px;
  }
  .hero-inner {
    position: relative; display: flex; flex-direction: column;
    align-items: center; text-align: center; gap: 1.5rem;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 100px; padding: 0.35rem 1rem;
    font-size: 0.8rem; color: var(--muted);
  }
  .badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%,100% { opacity: 1; } 50% { opacity: 0.4; }
  }
  .hero-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.4rem, 9vw, 6.5rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .grad-text {
    font-style: italic;
    color: var(--accent-ink);
  }
  .hero-sub {
    max-width: 580px; font-size: 1.08rem; font-weight: 300;
    color: var(--muted); line-height: 1.7;
  }
  .hero-sub code {
    font-family: var(--mono); font-size: 0.85em;
    background: var(--bg2);
    border: 1px solid var(--line);
    padding: 0.1rem 0.4rem; border-radius: 4px;
    color: var(--accent-ink);
  }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--accent); color: #0b0b0c;
    padding: 0.75rem 1.75rem; border-radius: var(--r);
    font-weight: 600; font-size: 0.95rem; text-decoration: none;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-primary:hover { background: #ff7049; transform: translateY(-1px); text-decoration: none; }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text); padding: 0.75rem 1.5rem;
    border-radius: var(--r); font-weight: 500; font-size: 0.95rem;
    text-decoration: none; transition: border-color 0.15s, transform 0.1s;
  }
  .btn-ghost:hover { border-color: var(--text); transform: translateY(-1px); text-decoration: none; }
  .hero-stars { margin-top: -0.5rem; }

  /* Floating terminal */
  .terminal-float {
    margin-top: 1rem;
    background: var(--bg3);
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    width: 100%; max-width: 560px;
    animation: floatY 4s ease-in-out infinite;
  }
  @keyframes floatY {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  .term-header {
    background: var(--bg2); padding: 0.55rem 1rem;
    display: flex; align-items: center; gap: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot.r { background: #ff5f57; } .dot.y { background: #febc2e; } .dot.g { background: #28c840; }
  .term-title { margin-left: auto; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .term-body { padding: 0.85rem 1.25rem; font-family: var(--mono); font-size: 0.78rem; font-weight: 500; }
  .term-line { display: flex; gap: 0.75rem; line-height: 1.9; }
  .term-line.wrap .term-cmd { word-break: break-all; white-space: normal; }
  .term-prompt { color: var(--accent-ink); user-select: none; }
  .term-cmd { color: var(--text); }
  .term-out { color: var(--muted); padding-left: 1.5rem; }
  .ok { color: var(--accent-ink); }
  .dim { opacity: 0.55; }
  .typing::after {
    content: '▍'; animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

  /* ── STATS BAR ────────────────────────────────────────────── */
  .stats-bar {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    padding: 1.6rem 0;
  }
  .stats-inner {
    display: flex; flex-wrap: wrap;
    justify-content: center; gap: 2rem 3.5rem;
