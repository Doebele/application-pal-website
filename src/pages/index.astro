---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const GITHUB_URL = 'https://github.com/Doebele/application-pal';
const INSTALL_URL = '/application-pal-website/install';

const features = [
  {
    icon: 'brain',
    grad: 'linear-gradient(135deg,#0a3e42,#dc143c)',
    title: 'AI coaching',
    desc: '13 stage-specific analyses — not generic tips. Checks ATS keyword gaps, generates interview prep guides and salary negotiation scripts, then hands you an onboarding checklist after you accept.',
  },
  {
    icon: 'kanban-board',
    grad: 'linear-gradient(135deg,#0a3e42,#006b73)',
    title: 'Kanban + table view',
    desc: 'Drag applications from Inbox → CV → Cover Letter → Sent → Interview. Switch to the table view for a spreadsheet-style overview with 15 configurable columns — resize, reorder, pin — including AI match score and salary data.',
  },
  {
    icon: 'edit-pencil',
    grad: 'linear-gradient(135deg,#8b1a2b,#f59e0b)',
    title: 'Cover letter coach',
    desc: 'A guided Prepare → Draft → Result workspace. Your personal guidance — structure, values, tone, no-gos — is applied to every letter, every generation is versioned, and a one-click humanizer makes AI prose sound like you.',
  },
  {
    icon: 'download-circle',
    grad: 'linear-gradient(135deg,#dc143c,#0a3e42)',
    title: 'RAV / ORP export',
    desc: 'Prove your job search for Swiss unemployment insurance in one click: a formatted proof-of-search report covering all applications, exported to Google Sheets or CSV — with application type and proof method per entry.',
  },
  {
    icon: 'calendar',
    grad: 'linear-gradient(135deg,#1a7045,#0a3e42)',
    title: 'Calendar + timeline',
    desc: 'Monthly and weekly calendar views show every interview, deadline, and follow-up; the timeline lays out your entire search over time. Log format, location, and interviewer details, then export to Google Calendar or iCal.',
  },
  {
    icon: 'folder',
    grad: 'linear-gradient(135deg,#f59e0b,#ef4444)',
    title: 'Google Drive',
    desc: 'Connect your Google account and application-pal creates a folder for each job the moment you add it. CV templates and cover letter drafts copy over with formatting intact — exported as formatted Google Docs.',
  },
  {
    icon: 'group',
    grad: 'linear-gradient(135deg,#dc143c,#8b1a2b)',
    title: 'Multi-user',
    desc: 'One instance, multiple users. Invite-based registration keeps your server private. Every user gets an isolated workspace — no one sees anyone else\'s applications.',
  },
  {
    icon: 'home',
    grad: 'linear-gradient(135deg,#8b1a2b,#0a3e42)',
    title: 'Flexible AI',
    desc: 'Six AI providers supported: Ollama and LM Studio run fully offline on your hardware. Anthropic, OpenAI, Google Gemini, and OpenRouter connect via your own API key — configured in the UI, not in config files.',
  },
  {
    icon: 'user',
    grad: 'linear-gradient(135deg,#0a3e42,#1a7045)',
    title: 'Persona profiles',
    desc: 'Declare your context — school leaver, career starter, or career changer — and the app adapts to your use case: AI tone, prompts, and recommendations adjust to where you are, with your Master CV, LinkedIn bio, and notes feeding every analysis.',
  },
];

const stats = [
  { num: '13', label: 'AI analyses per application' },
  { num: '6', label: 'AI providers — 2 fully local' },
  { num: '3', label: 'languages · DE / EN / FR' },
  { num: '100%', label: 'self-hosted & private' },
];

const steps = [
  {
    num: '01',
    title: 'Download & start',
    desc: 'Fetch the compose file, set a database password in .env, and start the full stack — ready in about a minute.',
    code: 'curl -O https://raw.githubusercontent.com/Doebele/application-pal/main/docker-compose.release.yml\ncurl -O https://raw.githubusercontent.com/Doebele/application-pal/main/.env.example\ncp .env.example .env\ndocker compose -f docker-compose.release.yml up -d',
  },
  {
    num: '02',
    title: 'Create your account',
    desc: 'Open localhost:8070 — the setup form guides you through your first account (e-mail + password). No verification loop, no credit card.',
    code: 'open http://localhost:8070',
  },
  {
    num: '03',
    title: 'Start tracking',
    desc: 'Add your first application, move it through the board, and let AI coaching do the rest.',
    code: null,
  },
];
---

<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/application-pal-website/" class="nav-logo">
        <Icon name="attachment" size={22} class="logo-mark" />
        <span>application-pal</span>
      </a>
      <nav class="nav-links">
        <a href="#features">Features</a>
        <a href="#screenshots">Preview</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="nav-gh">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
          GitHub
        </a>
        <a href={INSTALL_URL} class="btn-nav-cta">Get started</a>
        <ThemeToggle />
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow glow-1" aria-hidden="true"></div>
    <div class="hero-glow glow-2" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-badge" data-reveal>
        <span class="badge-dot"></span>
        Open source · Local-first · Free forever
      </div>

      <h1 class="hero-title" data-reveal>
        Stop losing track.<br />
        <em class="grad-text">Start landing jobs.</em>
      </h1>

      <p class="hero-sub" data-reveal>
        application-pal runs at <code>localhost:8070</code> — no cloud account,
        no subscription, no data leaving your computer.
        One <code>docker&nbsp;compose</code> command and you're tracking.
      </p>

      <div class="hero-ctas" data-reveal>
        <a href={INSTALL_URL} class="btn-primary">
          Get started — it's free
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
          View on GitHub
        </a>
      </div>

      <div class="hero-stars" data-reveal>
        <a href={`${GITHUB_URL}/stargazers`} target="_blank" rel="noopener">
          <img src="https://img.shields.io/github/stars/Doebele/application-pal?style=flat&logo=github&labelColor=0b0b0c&color=8a8780" alt="GitHub stars" width="120" height="20" loading="lazy" />
        </a>
      </div>

      <!-- Floating terminal card -->
      <div class="terminal-float" aria-hidden="true" data-reveal>
        <div class="term-header">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="term-title">Terminal</span>
        </div>
        <div class="term-body">
          <div class="term-line wrap"><span class="term-prompt">$</span> <span class="term-cmd">curl -O https://raw.githubusercontent.com/Doebele/application-pal/main/docker-compose.release.yml</span></div>
          <div class="term-line wrap"><span class="term-prompt">$</span> <span class="term-cmd">curl -O https://raw.githubusercontent.com/Doebele/application-pal/main/.env.example</span></div>
          <div class="term-line dim"><span class="term-prompt">$</span> <span class="term-cmd">cp .env.example .env &amp;&amp; $EDITOR .env</span></div>
          <div class="term-line"><span class="term-prompt">$</span> <span class="term-cmd typing">docker compose -f docker-compose.release.yml up -d</span></div>
          <div class="term-line term-out">✔ Container application-pal-db-1 <span class="ok">Started</span></div>
          <div class="term-line term-out">✔ Container application-pal-backend-1 <span class="ok">Started</span></div>
          <div class="term-line term-out">✔ Container application-pal-frontend-1 <span class="ok">Started</span></div>
          <div class="term-line term-out dim">→ Open http://localhost:8070</div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar">
    <div class="container stats-inner">
      {stats.map(s => (
        <div class="stat" data-reveal>
          <span class="stat-num">{s.num}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section features" id="features">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2 class="section-title">Everything you need. Nothing you don't.</h2>
        <p class="section-sub">Built for job seekers who want full control — and their data on their machine.</p>
      </div>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card" data-reveal>
            <div class="feature-icon-wrap">
              <Icon name={f.icon} size={22} class="feature-icon" />
            </div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SCREENSHOTS -->
  <section class="section screenshots" id="screenshots">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2 class="section-title">See it in action.</h2>
        <p class="section-sub">Every view runs locally. Your data never leaves your machine.</p>
      </div>

      <div class="tabs" data-reveal>
        <input type="radio" name="tab" id="tab-kanban" checked />
        <input type="radio" name="tab" id="tab-calendar" />
        <input type="radio" name="tab" id="tab-timeline" />
        <input type="radio" name="tab" id="tab-ai" />
        <input type="radio" name="tab" id="tab-letter" />
        <input type="radio" name="tab" id="tab-rav" />
        <input type="radio" name="tab" id="tab-drive" />
        <input type="radio" name="tab" id="tab-multiuser" />
        <input type="radio" name="tab" id="tab-flexai" />
        <input type="radio" name="tab" id="tab-persona" />

        <div class="tab-labels">
          <label for="tab-kanban"><Icon name="kanban-board" size={15} /> Kanban board</label>
          <label for="tab-calendar"><Icon name="calendar" size={15} /> Calendar</label>
          <label for="tab-timeline"><Icon name="graph-up" size={15} /> Timeline</label>
          <label for="tab-ai"><Icon name="brain" size={15} /> AI coaching</label>
          <label for="tab-letter"><Icon name="edit-pencil" size={15} /> Letter coach</label>
          <label for="tab-rav"><Icon name="download-circle" size={15} /> RAV report</label>
          <label for="tab-drive"><Icon name="folder" size={15} /> Google Drive</label>
          <label for="tab-multiuser"><Icon name="group" size={15} /> Multi-user</label>
          <label for="tab-flexai"><Icon name="home" size={15} /> Flexible AI</label>
          <label for="tab-persona"><Icon name="user" size={15} /> Persona</label>
        </div>

        <div class="browser-frame">
          <div class="browser-chrome">
            <span class="bdot r"></span><span class="bdot y"></span><span class="bdot g"></span>
            <span class="address-bar">localhost:8070</span>
          </div>
          <div class="tab-panel" id="panel-kanban">
            <img src="/application-pal-website/screenshots/kanban.png" alt="Kanban board" class="screenshot-img shot-dark" width="1480" height="820" loading="lazy" onerror="this.style.display='none'" />
            <img src="/application-pal-website/screenshots/kanban-light.png" alt="Kanban board" class="screenshot-img shot-light" width="1480" height="820" loading="lazy" onerror="this.style.display='none';document.getElementById('ph-kanban').style.display='flex'" />
            <div id="ph-kanban" class="screenshot-ph">
              <svg viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="900" height="500" fill="#fef8ee"/>
                <rect x="0" y="0" width="180" height="500" fill="#ffffff"/>
                <rect x="16" y="16" width="148" height="30" rx="6" fill="#f0ece4"/>
                <rect x="16" y="58" width="148" height="26" rx="5" fill="#0a3e42" opacity=".1"/>
                <rect x="36" y="65" width="70" height="12" rx="3" fill="#0a3e42"/>
                <rect x="16" y="92" width="148" height="26" rx="5" fill="#ffffff"/>
                <rect x="36" y="99" width="55" height="12" rx="3" fill="#6b7f80"/>
                <rect x="16" y="126" width="148" height="26" rx="5" fill="#ffffff"/>
                <rect x="36" y="133" width="65" height="12" rx="3" fill="#6b7f80"/>
                <!-- columns -->
                {['Inbox','CV','Sent','Interview'].map((col, i) => (
                  `<g key="${col}">
                    <rect x="${196 + i*176}" y="12" width="160" height="22" rx="4" fill="#ffffff"/>
                    <text x="${276 + i*176}" y="27" fill="#6b7f80" font-size="11" text-anchor="middle" font-family="monospace">${col}</text>
                    <rect x="${196 + i*176}" y="42" width="160" height="68" rx="6" fill="#ffffff"/>
                    <rect x="${208 + i*176}" y="52" width="100" height="10" rx="2" fill="#212121" opacity=".7"/>
                    <rect x="${208 + i*176}" y="68" width="70" height="8" rx="2" fill="#6b7f80"/>
                    <rect x="${208 + i*176}" y="82" width="50" height="16" rx="8" fill="#0a3e42" opacity=".15"/>
                    <rect x="${196 + i*176}" y="118" width="160" height="58" rx="6" fill="#ffffff"/>
                    <rect x="${208 + i*176}" y="128" width="85" height="10" rx="2" fill="#212121" opacity=".5"/>
                    <rect x="${208 + i*176}" y="144" width="60" height="8" rx="2" fill="#6b7f80"/>
                  </g>`
                ))}
                <!-- Interview highlight -->
                <rect x="548" y="42" width="160" height="68" rx="6" fill="#ffffff" stroke="#1a7045" stroke-width="1.5"/>
                <rect x="560" y="52" width="100" height="10" rx="2" fill="#212121" opacity=".9"/>
                <rect x="560" y="68" width="70" height="8" rx="2" fill="#1a7045" opacity=".7"/>
              </svg>
              <span class="ph-label">Kanban Board — add screenshots/kanban.png to show real UI</span>
            </div>
          </div>

          <div class="tab-panel" id="panel-calendar">
            <img src="/application-pal-website/screenshots/calendar.png" alt="Calendar view" class="screenshot-img shot-dark" width="1480" height="820" loading="lazy" onerror="this.style.display='none'" />
            <img src="/application-pal-website/screenshots/calendar-light.png" alt="Calendar view" class="screenshot-img shot-light" width="1480" height="820" loading="lazy" onerror="this.style.display='none';document.getElementById('ph-calendar').style.display='flex'" />
            <div id="ph-calendar" class="screenshot-ph">
              <svg viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="900" height="500" fill="#fef8ee"/>
                <rect x="0" y="0" width="900" height="44" fill="#fef8ee"/>
                <text x="24" y="28" fill="#212121" font-size="14" font-family="monospace" font-weight="bold">June 2026</text>
                <rect x="750" y="10" width="70" height="24" rx="5" fill="#ffffff"/>
                <text x="785" y="26" fill="#6b7f80" font-size="10" text-anchor="middle" font-family="monospace">Month</text>
                <rect x="828" y="10" width="60" height="24" rx="5" fill="#0a3e42" opacity=".2"/>
                <text x="858" y="26" fill="#0a3e42" font-size="10" text-anchor="middle" font-family="monospace">Week</text>
                <!-- Grid -->
                {['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map((d, i) => (
                  `<text x="${36 + i*120}" y="66" fill="#6b7f80" font-size="10" font-family="monospace">${d}</text>`
                ))}
                <line x1="0" y1="74" x2="900" y2="74" stroke="#ffffff" stroke-width="1"/>
                <!-- Day cells -->
                {[0,1,2,3,4,5,6].map(i => (
                  `<rect x="${24 + i*120}" y="80" width="108" height="90" rx="4" fill="#fef8ee" opacity=".6"/>`
                ))}
                <!-- Events -->
                <rect x="145" y="112" width="106" height="18" rx="3" fill="#1a7045" opacity=".9"/>
                <text x="155" y="124" fill="#fef8ee" font-size="9" font-family="monospace" font-weight="bold">Interview @ Google</text>
                <rect x="385" y="96" width="106" height="18" rx="3" fill="#ef4444" opacity=".8"/>
                <text x="395" y="108" fill="#fff" font-size="9" font-family="monospace">Application deadline</text>
                <rect x="505" y="112" width="106" height="18" rx="3" fill="#0a3e42" opacity=".7"/>
                <text x="515" y="124" fill="#fff" font-size="9" font-family="monospace">Follow-up email</text>
              </svg>
              <span class="ph-label">Calendar — add screenshots/calendar.png to show real UI</span>
            </div>
          </div>

          <div class="tab-panel" id="panel-timeline">
            <img src="/application-pal-website/screenshots/timeline.png" alt="Timeline view" class="screenshot-img shot-dark" width="1480" height="820" loading="lazy" onerror="this.style.display='none'" />
            <img src="/application-pal-website/screenshots/timeline-light.png" alt="Timeline view" class="screenshot-img shot-light" width="1480" height="820" loading="lazy" onerror="this.style.display='none';document.getElementById('ph-timeline').style.display='flex'" />
            <div id="ph-timeline" class="screenshot-ph">
              <span class="ph-label">Timeline — add screenshots/timeline.png to show real UI</span>
            </div>
          </div>

          <div class="tab-panel" id="panel-letter">
            <img src="/application-pal-website/screenshots/letter-coach.png" alt="Cover Letter Coach" class="screenshot-img shot-dark" width="1480" height="820" loading="lazy" onerror="this.style.display='none'" />
            <img src="/application-pal-website/screenshots/letter-coach-light.png" alt="Cover Letter Coach" class="screenshot-img shot-light" width="1480" height="820" loading="lazy" onerror="this.style.display='none';document.getElementById('ph-letter').style.display='flex'" />
            <div id="ph-letter" class="screenshot-ph">
              <span class="ph-label">Letter Coach — add screenshots/letter-coach.png to show real UI</span>
            </div>
          </div>

          <div class="tab-panel" id="panel-rav">
            <img src="/application-pal-website/screenshots/rav-dialog.png" alt="RAV report export" class="screenshot-img shot-dark" width="1480" height="820" loading="lazy" onerror="this.style.display='none'" />
            <img src="/application-pal-website/screenshots/rav-dialog-light.png" alt="RAV report export" class="screenshot-img shot-light" width="1480" height="820" loading="lazy" onerror="this.style.display='none';document.getElementById('ph-rav').style.display='flex'" />
            <div id="ph-rav" class="screenshot-ph">
              <span class="ph-label">RAV Report — add screenshots/rav-dialog.png to show real UI</span>
            </div>
          </div>

          <div class="tab-panel" id="panel-ai">
            <img src="/application-pal-website/screenshots/ai-coaching.png" alt="AI Coaching" class="screenshot-img shot-dark" width="1480" height="820" loading="lazy" onerror="this.style.display='none'" />
            <img src="/application-pal-website/screenshots/ai-coaching-light.png" alt="AI Coaching" class="screenshot-img shot-light" width="1480" height="820" loading="lazy" onerror="this.style.display='none';document.getElementById('ph-ai').style.display='flex'" />
            <div id="ph-ai" class="screenshot-ph">
              <svg viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="900" height="500" fill="#fef8ee"/>
                <rect x="0" y="0" width="300" height="500" fill="#fef8ee"/>
                <rect x="16" y="16" width="268" height="76" rx="6" fill="#ffffff"/>
                <rect x="28" y="26" width="110" height="12" rx="3" fill="#212121" opacity=".8"/>
                <rect x="28" y="44" width="75" height="9" rx="2" fill="#6b7f80"/>
                <rect x="28" y="60" width="55" height="16" rx="8" fill="#1a7045" opacity=".2"/>
                <text x="55" y="71" fill="#1a7045" font-size="9" font-family="monospace">Interview</text>
                <!-- Chat -->
                <rect x="316" y="0" width="584" height="44" fill="#fef8ee"/>
                <text x="336" y="28" fill="#212121" font-size="13" font-family="monospace" font-weight="bold">🤖 AI Coach</text>
                <!-- AI bubble -->
                <rect x="328" y="56" width="380" height="88" rx="8" fill="#ffffff"/>
                <rect x="340" y="68" width="340" height="9" rx="2" fill="#6b7f80"/>
                <rect x="340" y="83" width="300" height="9" rx="2" fill="#6b7f80"/>
                <rect x="340" y="98" width="260" height="9" rx="2" fill="#6b7f80"/>
                <rect x="340" y="113" width="180" height="9" rx="2" fill="#6b7f80"/>
                <!-- Chips -->
                <rect x="328" y="156" width="118" height="24" rx="12" fill="#0a3e42" opacity=".15" stroke="#0a3e42" stroke-width="1"/>
                <text x="387" y="171" fill="#0a3e42" font-size="9" text-anchor="middle" font-family="monospace">ATS Keywords</text>
                <rect x="454" y="156" width="128" height="24" rx="12" fill="#dc143c" opacity=".15" stroke="#dc143c" stroke-width="1"/>
                <text x="518" y="171" fill="#dc143c" font-size="9" text-anchor="middle" font-family="monospace">Interview Prep</text>
